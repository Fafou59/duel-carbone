// Configuration de l'hébergement chez Cloudflare (Workers), versionnée avec le code.
// Cloudflare construit le jeu (npm run build, réglé dans son tableau de bord), puis publie le dossier dist/
// et le serveur (serveur/index.ts). Voir docs/adr/0003-hebergement-cloudflare.md et 0005-serveur-worker-d1-sans-identite.md.
//
// Le déploiement, réglé lui aussi dans le tableau de bord (Workers Builds), appelle un script de package.json :
//   - sur main : « npm run deployer » applique les nouvelles migrations à la base de production, puis déploie ;
//   - sur les autres branches : « npm run deployer:apercu » fait de même avec la base des aperçus, puis publie l'aperçu.
// Le « && » entre les deux étapes garantit que si la migration échoue, rien n'est déployé : la production garde
// l'ancienne version. Le jeton de Workers Builds doit avoir la permission « D1 : Edit » (ticket 117).
// Attention : les réglages de l'onglet « Base des aperçus » ne valent que pour les aperçus créés ensuite ; un
// aperçu qui existe déjà garde la commande qu'il avait à sa création (constaté le 24/11/2026).
//
// Deux règles en découlent pour le dossier migrations/ :
//   - une migration AJOUTE sans casser (une table, une colonne) : elle passe quelques secondes avant le nouveau code,
//     donc l'ancien code doit encore fonctionner avec elle. Renommer ou supprimer se fait en deux fois ;
//   - une seule branche à la fois porte une nouvelle migration, car la base des aperçus est partagée par toutes.
{
  // Doit être identique au nom du Worker dans le tableau de bord Cloudflare.
  "name": "duel-carbone",
  // Le serveur : le code qui répond aux adresses /api/… (le Rang du jour, le Taux d'erreur, les Séances).
  "main": "serveur/index.ts",
  // Version des règles d'exécution de Cloudflare à utiliser (une date figée, pour éviter les surprises).
  "compatibility_date": "2026-11-01",
  "assets": {
    // Le dossier produit par Vite : servi tel quel, gratuitement et sans limite de trafic.
    "directory": "./dist",
    // Seules les adresses /api/… passent par le serveur ; tout le reste est servi comme avant, sans l'appeler
    // (le serveur gratuit est limité à 100 000 appels par jour, les fichiers ne le sont pas).
    "run_worker_first": ["/api/*"]
  },
  // La base D1 de production, créée dans la juridiction « eu » (les données restent dans l'Union européenne).
  // Le serveur la reçoit sous le nom env.BASE. Ses tables se créent avec les fichiers du dossier migrations/,
  // appliqués à chaque déploiement (voir plus haut). À la main, en cas de besoin :
  //   npx wrangler d1 migrations apply duel-carbone --remote
  // « preview_database_id » désigne la base des aperçus (voir « previews » plus bas) pour les commandes de Wrangler :
  //   npx wrangler d1 migrations apply duel-carbone --remote --preview
  // (Un « wrangler deploy --dry-run » affiche cet identifiant-là à côté de env.BASE : ce n'est que l'affichage,
  // le déploiement utilise bien « database_id ».)
  "d1_databases": [
    {
      "binding": "BASE",
      "database_name": "duel-carbone",
      "database_id": "b69ad0f7-ed91-4091-bfa4-46ae8056b334",
      "preview_database_id": "7562794e-fd5e-4c6d-9cf7-c67cacc3ba92"
    }
  ],
  // Les Séances du Mode animation (ADR 0007) : un Durable Object par Séance, classe Seance de serveur/seance.ts.
  // Le serveur le reçoit sous le nom env.SEANCE et crée chaque Séance dans la juridiction « eu » (serveur/seance-api.ts).
  // « exports » déclare la classe avec le stockage SQLite, seul permis sur le plan gratuit (vérifié sur un aperçu
  // le 26/11/2026, juridiction « eu » comprise). Il ne s'applique qu'avec « wrangler deploy ». Renommer ou supprimer
  // la classe plus tard se fait par une « pierre tombale » dans « exports », et efface toutes les Séances.
  // Essai en local (npx wrangler dev) : le moteur local ne connaît pas les juridictions ; mettre
  // SEANCE_SANS_JURIDICTION=oui dans un fichier .dev.vars (jamais ici).
  "durable_objects": { "bindings": [{ "name": "SEANCE", "class_name": "Seance" }] },
  "exports": { "Seance": { "type": "durable-object", "storage": "sqlite" } },
  // Le Rappel du matin (ADR 0008, serveur/rappel.ts). La tâche planifiée tourne en heure UTC : lancée à 5 h et à
  // 6 h UTC, elle n'agit qu'à celle des deux où il est 7 h à Paris (6 h UTC l'hiver, 5 h UTC l'été). Le plan
  // gratuit en permet 5 par compte ; celle-ci n'en utilise qu'une.
  "triggers": { "crons": ["0 5,6 * * *"] },
  // La file du Rappel : la tâche y range des lots de 25 abonnements, et Cloudflare confie chaque lot à une exécution
  // à part (10 ms de calcul chacune sur le plan gratuit ; 25 envois en font environ 8). Un lot par exécution
  // (max_batch_size 1). Si la base ne répond pas, le lot est réessayé deux fois au plus. Sur le plan gratuit, la
  // file permet 10 000 opérations par jour, environ 3 par lot : de quoi envoyer plus de 80 000 Rappels.
  // La file se crée une fois pour toutes, avant le premier déploiement qui la déclare :
  //   npx wrangler queues create duel-carbone-rappel
  "queues": {
    "producers": [{ "queue": "duel-carbone-rappel", "binding": "FILE_DU_RAPPEL" }],
    "consumers": [{ "queue": "duel-carbone-rappel", "max_batch_size": 1, "max_retries": 2 }]
  },
  // Les clés VAPID du Rappel sont des secrets, jamais écrits ici : VAPID_CLE_PUBLIQUE et VAPID_CLE_PRIVEE
  // (npx wrangler secret put …, ou npx wrangler preview secret bulk … --name <aperçu> pour un aperçu).
  // Les aperçus des branches (commande « npx wrangler preview », lancée par Cloudflare pour chaque branche autre
  // que main). Ils n'héritent pas des bases de la production : on leur en donne une à part, elle aussi dans l'UE,
  // partagée par tous les aperçus. Ainsi, essayer un aperçu ne fausse jamais le Rang du jour des vrais joueurs.
  // Les Durable Objects, eux, sont propres à chaque aperçu : Cloudflare lui donne ses propres Séances, effacées avec
  // lui. Il faut seulement répéter la liaison env.SEANCE ici (sinon, l'aperçu répond par une erreur 1101).
  //
  // Les aperçus ne lancent ni la tâche planifiée ni la file du Rappel (Cloudflare ne le permet pas) : RAPPEL_ESSAI
  // y ouvre une adresse d'essai, qui envoie le Rappel tout de suite à l'appareil qui le demande (serveur/rappel.ts).
  "previews": {
    "vars": { "RAPPEL_ESSAI": "oui" },
    "durable_objects": { "bindings": [{ "name": "SEANCE", "class_name": "Seance" }] },
    "d1_databases": [
      {
        "binding": "BASE",
        "database_name": "duel-carbone-apercus",
        "database_id": "7562794e-fd5e-4c6d-9cf7-c67cacc3ba92"
      }
    ]
  }
}
