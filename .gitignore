# Dépendances téléchargées par npm (se réinstallent avec `npm install`)
node_modules/

# Fichiers générés par la construction du site et les tests
dist/
coverage/

# Secrets et réglages locaux (ex. la future clé d'API ADEME) — ne jamais les publier
.env
.env.*
!.env.example

*.local

# Journaux, éditeurs et fichiers système
*.log
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Rapports et traces des tests de bout en bout (Playwright)
playwright-report/
test-results/
