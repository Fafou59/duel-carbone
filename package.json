{
  "name": "duel-carbone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "captures": "playwright test --config playwright.captures.config.ts",
    "import": "node --env-file-if-exists=.env scripts/import/index.ts && npm run calibrer",
    "calibrer": "node scripts/calibrer.ts && node scripts/calendrier.ts",
    "calendrier": "node scripts/calendrier.ts",
    "icones": "node scripts/icones/index.ts",
    "logo": "node scripts/logo.ts",
    "image-partage": "node scripts/image-partage.ts",
    "analyse:paires": "node scripts/analyse-paires.ts",
    "empreinte-ia": "node scripts/empreinte-ia.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
